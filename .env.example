# Kopiere diese Datei nach ".env" und passe die Werte an:  cp .env.example .env

# --- Web ---
# Port, unter dem die App im Heimnetz erreichbar ist (http://wgserver:8095)
APP_PORT=8095
# Zugangsdaten für die Anmeldung
APP_USERNAME=admin
APP_PASSWORD=bitte-aendern
# Geheimer Schlüssel für das Login-Cookie. Leer lassen = wird automatisch erzeugt
# und in ./data/secret_key gespeichert.
SECRET_KEY=

# Zeitzone
TZ=Europe/Berlin

# --- KI ---
# "ollama" (Standard) oder "openai" (jede OpenAI-kompatible API)
LLM_PROVIDER=ollama
# Ollama im Docker-Netzwerk "ki". Für OpenAI z. B. https://api.openai.com/v1
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen-paperless
# Nur für OpenAI-kompatible APIs nötig
LLM_API_KEY=
# Maximale Wartezeit pro KI-Anfrage in Sekunden (20 Minuten)
LLM_TIMEOUT=1200
# Kontextlänge für Ollama. Leer = Standard des Modells (empfohlen, weil andere
# Dienste dasselbe Modell nutzen und ein abweichender Wert ein Neuladen erzwingt).
LLM_NUM_CTX=
# Maximale Länge des Bontexts (Zeichen), der an die KI geht. Längere Texte
# werden gekürzt und der Bon auf "prüfen" gesetzt.
LLM_MAX_INPUT_CHARS=6000

# Dein eigener Name und deine Adresse(n), durch ";" getrennt. Diese werden nie als
# Händler übernommen (die KI verwechselt bei Rechnungen manchmal Absender und Empfänger).
# Bleibt nur in dieser Datei auf deinem Server.
# Beispiel: OWN_NAMES=Max Mustermann;Musterstraße 1;12345 Musterstadt
OWN_NAMES=

# --- Texterkennung ---
OCR_LANG=deu+eng

# Positionen zuerst per Regel auslesen (schnell, ohne KI). Ergeben sie exakt die
# Summe, wird die KI gar nicht gefragt. "false" = immer die KI fragen.
RULE_PARSER=true

# --- Plausibilität ---
# Erlaubte Abweichung zwischen Summe der Positionen und Gesamtsumme (Euro)
SUM_TOLERANCE=0.05
